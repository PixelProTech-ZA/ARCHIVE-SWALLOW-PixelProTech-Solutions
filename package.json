{
  "name": "pixel-archive-swallow",
  "version": "0.1.0",
  "description": "PixelProTech Solutions — desktop archive ingestion system. SCAN -> SWALLOW -> READ -> SORT -> FIND",
  "main": "main.js",
  "author": "PixelProTech Solutions (Pty) Ltd — Reg 2026/622131/07",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "npm rebuild better-sqlite3 --loglevel=error && node logic.test.js && node image.test.js && npm run rebuild:electron --silent",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^5.1.1",
    "pdf-lib": "^1.17.1",
    "uuid": "^9.0.1",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pixelprotech.archiveswallow",
    "productName": "Pixel Archive Swallow",
    "files": ["*.js", "!*.test.js", "*.html", "*.css", "*.ico", "*.icns", "*.png", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.ico" },
    "mac": { "target": "dmg", "icon": "icon.icns", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "icon": "icon-512.png", "category": "Office" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
